  "mcps": [
    {
      "name": "Baidu Search",
      "type": "http",
      "desc": "百度网页搜索，中文信息检索首选。",
      "upstream": "",
      "homepage": "https://cloud.baidu.com/product/qianfan_mcp",
      "config": {
        "type": "http",
        "url": "https://qianfan.baidubce.com/v2/tools/web-search/mcp",
        "headers": {
          "Authorization": "Bearer <你的千帆 API Key>"
        }
      }
    },
    {
      "name": "Github",
      "type": "stdio",
      "desc": "GitHub 全功能操作：仓库、Issue、PR、文件读写。",
      "upstream": "github/github-mcp-server",
      "homepage": "https://github.com/github/github-mcp-server",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "<你的 GitHub PAT>"
        }
      }
    },
    {
      "name": "Markitdown",
      "type": "stdio",
      "desc": "多格式文件转 Markdown（PDF/DOCX/XLSX/图片等）。",
      "upstream": "microsoft/markitdown",
      "homepage": "https://github.com/microsoft/markitdown",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "markitdown-mcp-npx"
        ]
      }
    },
    {
      "name": "chrome-devtools",
      "type": "stdio",
      "desc": "Chrome DevTools 协议控制浏览器与性能分析。",
      "upstream": "ChromeDevTools/chrome-devtools-mcp",
      "homepage": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "chrome-devtools-mcp"
        ]
      }
    },
    {
      "name": "codebase-memory",
      "type": "stdio",
      "desc": "代码库索引与知识图谱，架构/调用链分析（本地自部署）。",
      "upstream": "DeusData/codebase-memory-mcp",
      "homepage": "https://github.com/DeusData/codebase-memory-mcp",
      "config": {
        "command": "<本地 codebase-memory-mcp 可执行文件路径>"
      }
    },
    {
      "name": "context7",
      "type": "stdio",
      "desc": "第三方编程库的最新官方文档实时查询。",
      "upstream": "upstash/context7",
      "homepage": "https://github.com/upstash/context7",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      }
    },
    {
      "name": "deepseek-search",
      "type": "stdio",
      "desc": "DeepSeek 官方 Search/Fetch 接口，实时网页搜索与网页正文抓取（需 DeepSeek API Key）。",
      "upstream": "zengzoxiong/deepseek-search-mcp",
      "homepage": "https://github.com/zengzoxiong/deepseek-search-mcp",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "deepseek-websearch-mcp"
        ],
        "env": {
          "DEEPSEEK_API_KEY": "<你的 DeepSeek API Key>"
        }
      }
    },
    {
      "name": "drawio",
      "type": "stdio",
      "desc": "生成与编辑 draw.io 图表文件。",
      "upstream": "jgraph/drawio-mcp",
      "homepage": "https://github.com/jgraph/drawio-mcp",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@drawio/mcp"
        ]
      }
    },
    {
      "name": "playwright",
      "type": "stdio",
      "desc": "Playwright 浏览器自动化与页面测试。",
      "upstream": "microsoft/playwright-mcp",
      "homepage": "https://github.com/microsoft/playwright-mcp",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@playwright/mcp"
        ]
      }
    },
    {
      "name": "rea",
      "type": "stdio",
      "desc": "逆向工程一条龙：静态分析、动态插桩、固件解包（npm rea-agents，本地自部署）。",
      "upstream": "morluto/rea",
      "homepage": "https://github.com/morluto/rea",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "node",
          "<rea-agents 安装目录>/scripts/rea.mjs",
          "mcp"
        ],
        "env": {
          "JAVA_HOME": "<JDK 21 路径>",
          "REA_JADX_MCP_JAR": "<JADX MCP JAR 路径>"
        }
      }
    },
    {
      "name": "windows-mcp",
      "type": "stdio",
      "desc": "Windows 桌面自动化：UIA 元素树感知 + 键鼠操作，20 工具含文件/注册表/进程。",
      "upstream": "CursorTouch/Windows-MCP",
      "homepage": "https://github.com/CursorTouch/Windows-MCP",
      "config": {
        "command": "uvx",
        "args": [
          "windows-mcp",
          "serve"
        ],
        "env": {
          "ANONYMIZED_TELEMETRY": "false"
        }
      }
    }
  ]
