  "mcps": [
    {
      "name": "Baidu Search",
      "type": "http",
      "desc": "百度网页搜索，中文信息检索首选。",
      "homepage": "https://cloud.baidu.com/product/qianfan_mcp",
      "config": {
        "type": "http",
        "url": "https://qianfan.baidubce.com/v2/tools/web-search/mcp",
        "headers": {
          "Authorization": "Bearer <你的千帆 API Key>"
        }
      }
    },
    {
      "name": "Github",
      "type": "stdio",
      "desc": "GitHub 全功能操作：仓库、Issue、PR、文件读写。",
      "homepage": "https://github.com/modelcontextprotocol/server-github",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "<你的 GitHub PAT>"
        }
      }
    },
    {
      "name": "filesystem",
      "type": "stdio",
      "desc": "本地文件系统读写与目录管理。",
      "homepage": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "<允许访问的目录1>",
          "<允许访问的目录2>"
        ]
      }
    },
    {
      "name": "git",
      "type": "stdio",
      "desc": "本地 Git 仓库操作（状态/提交/分支/差异）。",
      "homepage": "https://www.npmjs.com/package/mcp-git",
      "config": {
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "mcp-git"
        ]
      }
    },
